{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile-devagent",
      "type": "shell",
      "command": "npm --prefix vscode_extension/devagent run compile",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$tsc",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    }
  ]
}
